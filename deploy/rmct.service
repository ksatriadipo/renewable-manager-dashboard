[Unit]
Description=RM Control Tower web server
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/rmct
Environment=RMCT_CONFIG=/srv/rmct-private/config.json
ExecStart=/usr/bin/python3 -m rmct serve
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
